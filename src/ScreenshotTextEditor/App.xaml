<Application x:Class="ScreenshotTextEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#FF0F172A"/>
        <SolidColorBrush x:Key="BgPanel" Color="#FF1E293B"/>
        <SolidColorBrush x:Key="BgHover" Color="#FF334155"/>
        <SolidColorBrush x:Key="Accent" Color="#FF8B5CF6"/>
        <SolidColorBrush x:Key="AccentHover" Color="#FFA78BFA"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFF1F5F9"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FF94A3B8"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#FF334155"/>

        <Style TargetType="Button" x:Key="GlassButton">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#558B5CF6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#558B5CF6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
